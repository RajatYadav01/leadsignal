{
	"name": "@leadsignal/web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:report": "eslint . --format json --output-file lint-report.json || true",
		"preview": "vite preview",
		"test": "vitest",
		"test:unit": "vitest run unit.test.ts --passWithNoTests",
		"test:integration": "vitest run integration.test.ts --passWithNoTests",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/react-query": "^5.101.1",
		"@tanstack/react-table": "^9.2.4",
		"axios": "^1.17.0",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.78.0",
		"react-leaflet": "^5.0.0",
		"react-router": "^7.17.0",
		"recharts": "^3.8.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@leadsignal/eslint-config": "workspace:*",
		"@leadsignal/tsconfig": "workspace:*",
		"@rolldown/plugin-babel": "^0.2.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/coverage-v8": "^4.1.8",
		"@vitest/ui": "^4.1.8",
		"axios-mock-adapter": "^2.1.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"globals": "^17.11.0",
		"jsdom": "^29.1.1",
		"vite": "^8.2.2",
		"vitest": "^4.1.8"
	}
}
