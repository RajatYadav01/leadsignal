# -----------------------------------------------------------------------------
# Django REST Framework API Backend Configuration (v1)
# -----------------------------------------------------------------------------

# Django debug mode, should be set to False in production
DEBUG=True   

# A long, random string used as a secret key by Django (use a strong random string in production)
SECRET_KEY=leadsignal-secret-key-123456789

# Comma-separated list of backend domains 
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated list of allowed origins for CORS requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173

# Host URL for the web application
APP_HOST_URL=http://localhost:5173

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database_name>?sslmode=<disable|require>
DATABASE_URL=postgres://leadsignal:12514199@localhost:5432/dealsignal?sslmode=disable

# -----------------------------------------------------------------------------
# OpenRouter / LLM Provider Settings
# -----------------------------------------------------------------------------

# Base API URL for OpenRouter API requests (OpenAI-compatible endpoint)
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# API key from OpenRouter (or other compatible LLM provider) for making requests to the LLM endpoints
OPENROUTER_API_KEY=

# Primary LLM model used for generating explanations and insights
OPENROUTER_EXPLANATION_MODEL=